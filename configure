#!/bin/sh

if [ -z "$CC" ]; then
	CC=cc
fi

PREFIX=/usr/local
OPT=yes
DBG=yes
HARDEN=yes
VER=$(git describe --tags 2>/dev/null)
if [ -z "$VER" ]; then
	VER=$(git rev-parse --short HEAD 2>/dev/null)
	if [ -z "$VER" ]; then
		VER='<unknown version>'
	fi
fi

echo "configuring spnav-onshape-bridge - $VER"

srcdir="$(dirname "$0")"

for arg; do
	case "$arg" in
	--prefix=*)
		value=$(echo "$arg" | sed 's/--prefix=//')
		PREFIX=${value:-$PREFIX}
		;;
	--enable-opt)
		OPT=yes;;
	--disable-opt)
		OPT=no;;
	--enable-debug)
		DBG=yes;;
	--disable-debug)
		DBG=no;;
	--enable-hardening)
		HARDEN=yes;;
	--disable-hardening)
		HARDEN=no;;
	--help)
		echo 'usage: ./configure [options]'
		echo 'options:'
		echo '  --prefix=<path>: installation path (default: /usr/local)'
		echo '  --enable-opt: enable speed optimizations (default)'
		echo '  --disable-opt: disable speed optimizations'
		echo '  --enable-debug: include debugging symbols (default)'
		echo '  --disable-debug: don''t include debugging symbols'
		echo '  --enable-hardening: stack protector, fortify source, RELRO, PIE (default)'
		echo '  --disable-hardening: disable the above (not recommended; this daemon parses'
		echo '                       untrusted network input)'
		echo '  --help: print this help message'
		exit 0
		;;
	*)
		echo "unrecognized option: $arg" >&2
		exit 1
		;;
	esac
done

if ! pkg-config --exists openssl 2>/dev/null; then
	if [ ! -f /usr/include/openssl/ssl.h ] && [ ! -f /usr/local/include/openssl/ssl.h ]; then
		echo "OpenSSL development headers not found (need libssl-dev / openssl-devel)" >&2
		exit 1
	fi
fi

if [ ! -f /usr/include/spnav.h ] && [ ! -f /usr/local/include/spnav.h ]; then
	echo "libspnav headers not found (build/install libspnav first: https://github.com/FreeSpacenav/libspnav)" >&2
	exit 1
fi

echo "creating Makefile ..."
echo "PREFIX = $PREFIX" > Makefile
echo "srcdir = $srcdir" >> Makefile
echo "VERSION = $VER" >> Makefile
[ "$OPT" = yes ] && echo 'opt = -O2' >> Makefile
[ "$DBG" = yes ] && echo 'dbg = -g' >> Makefile

if [ "$HARDEN" = yes ]; then
	harden_cflags='-fstack-protector-strong -Wformat -Wformat-security -Werror=format-security -fPIE'
	# _FORTIFY_SOURCE needs -O1 or higher to do anything, and glibc warns if
	# it's set without optimization
	[ "$OPT" = yes ] && harden_cflags="$harden_cflags -D_FORTIFY_SOURCE=2"
	echo "harden_cflags = $harden_cflags" >> Makefile
	echo 'harden_ldflags = -Wl,-z,relro,-z,now -pie' >> Makefile
fi

if pkg-config --exists openssl 2>/dev/null; then
	echo "ssl_cflags = $(pkg-config --cflags openssl)" >> Makefile
	echo "ssl_libs = $(pkg-config --libs openssl)" >> Makefile
else
	echo 'ssl_libs = -lssl -lcrypto' >> Makefile
fi

cat "$srcdir/Makefile.in" >> Makefile

echo ""
echo "Configuration complete. Type make (or gmake) to build."
echo ""
