[Unit]
Description=Onshape 3D-mouse bridge for spacenavd
Documentation=https://github.com/Pace17881/spnav-onshape-bridge
After=spacenavd.service
Wants=spacenavd.service

[Service]
Type=simple
# Bare filename (not an absolute path): the binary lives in different places
# depending on how it was installed (a distro package puts it in /usr/bin,
# install.sh puts it in ~/.local/bin) - systemd looks up a bare filename in
# $PATH the same way a shell would, so this one unit file works for both,
# as long as both locations are covered here explicitly (systemd --user's
# own default $PATH does not reliably include ~/.local/bin).
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
ExecStart=spnav-onshape-bridge
Restart=on-failure
RestartSec=2

# Defense in depth beyond the daemon's own loopback-only bind and Origin
# allow-list: this process needs no filesystem access outside its own state
# dir, no new privileges, and no networking beyond the AF_INET loopback
# socket + the AF_UNIX socket to spacenavd.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=spnav-onshape-bridge
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressAllow=127.0.0.0/8
IPAddressDeny=any
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=default.target
