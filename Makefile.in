own_src = $(sort $(wildcard src/*.c))
src = $(own_src) third_party/cJSON.c
hdr = $(wildcard src/*.h)
obj = $(src:.c=.o)
bin = spnav-onshape-bridge

lib_src = $(filter-out src/main.c,$(src))
lib_obj = $(lib_src:.c=.o)

incpaths = -Isrc -Ithird_party -I/usr/local/include
libpaths = -L/usr/local/lib

CC ?= gcc
CFLAGS = -std=c99 -Wall -Wextra -D_GNU_SOURCE $(ssl_cflags) $(opt) $(dbg) $(harden_cflags) $(incpaths) $(user_cflags)
LDFLAGS = $(libpaths) -lspnav $(ssl_libs) -lm $(harden_ldflags) $(user_ldflags)

.PHONY: all
all: $(bin)

$(bin): $(obj)
	$(CC) -o $@ $(obj) $(LDFLAGS)

%.o: %.c $(hdr)
	$(CC) $(CFLAGS) -c $< -o $@

.PHONY: test
test: tests/test_mat4 tests/test_controller tests/test_ws
	./tests/test_mat4
	./tests/test_controller
	./tests/test_ws

tests/test_mat4: tests/test_mat4.c src/mat4.o
	$(CC) $(CFLAGS) -o $@ $^ -lm

tests/test_controller: tests/test_controller.c $(lib_obj)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

.PHONY: clean
clean:
	rm -f $(obj) $(bin) tests/test_mat4 tests/test_controller tests/test_ws tests/test_daemon

.PHONY: install
install: $(bin)
	install -d $(DESTDIR)$(PREFIX)/bin
	install -m 755 $(bin) $(DESTDIR)$(PREFIX)/bin/$(bin)
	install -d $(DESTDIR)$(PREFIX)/share/man/man1
	install -m 644 man/spnav-onshape-bridge.1 $(DESTDIR)$(PREFIX)/share/man/man1/

.PHONY: uninstall
uninstall:
	rm -f $(DESTDIR)$(PREFIX)/bin/$(bin)
	rm -f $(DESTDIR)$(PREFIX)/share/man/man1/spnav-onshape-bridge.1

tests/test_ws: tests/test_ws.c src/ws.o
	$(CC) $(CFLAGS) -o $@ $^ $(ssl_libs)

tests/test_daemon: tests/stub_spnav.c $(filter-out src/spnav_bridge.o,$(obj))
	$(CC) $(CFLAGS) -o $@ $^ $(ssl_libs) -lm $(user_ldflags)

.PHONY: test-integration
test-integration: tests/test_daemon
	python3 tests/test_transport.py
	python3 tests/test_cli.py
	python3 tests/test_robustness.py

# Rebuilds everything with AddressSanitizer + UndefinedBehaviorSanitizer and
# runs the full test suite under them, then cleans up so a normal `make`
# afterwards isn't left with mismatched sanitizer-instrumented objects.
# Most valuable for src/ws.c, src/http.c, src/wamp.c, src/controller.c -
# the code paths that parse untrusted network input.
.PHONY: test-sanitize
test-sanitize:
	$(MAKE) clean
	$(MAKE) test test-integration \
		user_cflags="-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all -g" \
		user_ldflags="-fsanitize=address,undefined"
	$(MAKE) clean

# clang-tidy and cppcheck are two independent static analyzers; run both
# rather than picking one, since they catch different things. Scoped to
# own_src (src/*.c), not third_party/cJSON.c - that's vendored, pinned
# upstream code (see third_party/LICENSE.cJSON) we don't modify, so linting
# it would just be noise. Each prints its own "not installed" message rather
# than failing silently if missing - matches the --doctor philosophy of
# telling you exactly what to fix.
.PHONY: lint
lint:
	@if command -v clang-tidy >/dev/null 2>&1; then \
		clang-tidy $(own_src) -- $(CFLAGS) || exit 1; \
	else \
		echo "clang-tidy not found (Arch: pacman -S clang | Debian/Ubuntu: apt install clang-tidy) - skipping" >&2; \
	fi
	@if command -v cppcheck >/dev/null 2>&1; then \
		cppcheck --enable=warning,performance,portability --error-exitcode=1 \
			--suppress=missingIncludeSystem $(incpaths) src/ || exit 1; \
	else \
		echo "cppcheck not found (Arch: pacman -S cppcheck | Debian/Ubuntu: apt install cppcheck) - skipping" >&2; \
	fi

.PHONY: shellcheck
shellcheck:
	@if command -v shellcheck >/dev/null 2>&1; then \
		shellcheck configure install.sh contrib/*.sh debian/*.postinst || exit 1; \
	else \
		echo "shellcheck not found (Arch: pacman -S shellcheck | Debian/Ubuntu: apt install shellcheck) - skipping" >&2; \
	fi

# Line coverage for own_src (not third_party/cJSON.c - vendored, not ours
# to improve) via the full test + test-integration suite. LC_ALL=C keeps
# gcov's "Lines executed:NN.NN% of N" summary line locale-independent so it
# can be parsed reliably. Rebuilds clean afterward, same as test-sanitize -
# coverage-instrumented objects shouldn't leak into a normal `make`.
.PHONY: coverage
coverage:
	@if ! command -v gcov >/dev/null 2>&1; then \
		echo "gcov not found (ships with gcc) - skipping" >&2; \
		exit 0; \
	fi
	$(MAKE) clean
	$(MAKE) test test-integration \
		user_cflags="--coverage -O0" \
		user_ldflags="--coverage"
	@rm -f ./*.gcov
	@echo; echo "Line coverage (src/*.c):"
	@total_lines=0; total_covered=0; \
	for f in $(own_src); do \
		summary=$$(LC_ALL=C gcov -n $$f -o src 2>/dev/null | grep "Lines executed" | head -1); \
		pct=$$(echo "$$summary" | sed -E 's/Lines executed:([0-9.]+)% of ([0-9]+)/\1/'); \
		lines=$$(echo "$$summary" | sed -E 's/Lines executed:([0-9.]+)% of ([0-9]+)/\2/'); \
		printf "  %-24s %6s%%  (%s lines)\n" "$$f" "$$pct" "$$lines"; \
		total_lines=$$((total_lines + lines)); \
		total_covered=$$(awk -v c=$$total_covered -v p=$$pct -v l=$$lines 'BEGIN{printf "%.4f", c + (p/100*l)}'); \
	done; \
	awk -v c=$$total_covered -v t=$$total_lines 'BEGIN{printf "  %-24s %6.1f%%  (%d lines)\n", "TOTAL", (c/t*100), t}'
	@rm -f ./*.gcov src/*.gcda src/*.gcno tests/*.gcda tests/*.gcno third_party/*.gcda third_party/*.gcno
	$(MAKE) clean
